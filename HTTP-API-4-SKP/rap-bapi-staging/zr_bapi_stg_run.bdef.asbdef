managed implementation in class zbp_r_bapi_stg_run unique;
strict ( 2 );

define behavior for ZR_BAPI_STG_RUN alias BapiRun
persistent table zbapi_stg_run
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  field ( readonly, numbering : managed ) RunUuid;

  field ( readonly ) BapiName, ExecMode,
                     WorkerThreads, WorkerRows,
                     Accepted, Workers,
                     Status, ErrorText,
                     CreatedBy, CreatedAt,
                     LastChangedBy, LastChangedAt, LocalLastChangedAt;

  create;
  update;
  delete;

  static action Submit
    parameter ZD_BAPI_STG_IN
    result    [1] ZD_BAPI_STG_OUT;

  mapping for zbapi_stg_run
  {
    RunUuid            = run_uuid;
    BapiName           = bapi_name;
    ExecMode           = exec_mode;
    WorkerThreads      = worker_threads;
    WorkerRows         = worker_rows;
    Accepted           = accepted;
    Workers            = workers;
    Status             = status;
    ErrorText          = error_text;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
