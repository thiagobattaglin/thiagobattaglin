flowchart LR
    Client["HTTP Client"]

    Client -->|"GET ?bapi_name=..."| Node["HTTP Service Node<br/>/sap/bc/http/sap/zbapi_integration"]
    Client -->|"POST body: input.json"| Node

    Node --> Handler["zcl_http_bapi_integration<br/>(composition root)"]

    subgraph CleanCore["Clean Core (released APIs only)"]
        Handler -->|"GET"| Builder["zcl_bapi_integration_builder<br/>xco_cp_json"]
        Handler -->|"POST"| Dispatcher["zcl_bapi_integration_dispatch<br/>xco_cp_json + resolve_workers"]
        Dispatcher -->|"chunks xstring<br/>EXPORT TO DATA BUFFER"| Parallel["cl_abap_parallel<br/>run_inline"]
        Parallel --> Provider["zcl_bapi_integration_parallel<br/>if_abap_parallel~do"]
        Provider --> Caller["zcl_bapi_integration_caller<br/>process_chunk"]
    end

    subgraph Legacy["Legacy Adapters (NOT Clean Core, on-premise only)"]
        LgcyIntro["zcl_bapi_integration_intro<br/>FUNCTION_IMPORT_INTERFACE<br/>DDIF_FIELDINFO_GET"]
        LgcyExec["zcl_bapi_integration_exec<br/>CALL FUNCTION dyn PARAMETER-TABLE<br/>BAPI_TRANSACTION_COMMIT/ROLLBACK"]
    end

    Builder -.->|"zif_bapi_integration_intro"| LgcyIntro
    Caller  -.->|"zif_bapi_integration_executor"| LgcyExec

    LgcyExec --> BAPI["CALL FUNCTION bapi_name<br/>(dinâmico)"]

    Handler -->|"200 OK / 202 Accepted"| Client

