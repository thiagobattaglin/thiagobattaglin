%%{ init: { "flowchart": { "htmlLabels": true } } }%%
flowchart LR
    Client([OData V4 Client]) -- "POST BapiRun/...Submit<br/>{ Payload: '&lt;JSON&gt;' }" --> Gateway["SAP Gateway<br/>OData V4 runtime"]
    Gateway --> BindingP["Service Binding<br/>ZUI_BAPI_RUN_O4"]
    BindingP --> ServiceDef["Service Definition<br/>ZUI_BAPI_RUN_O4"]
    ServiceDef --> Projection["Projection View<br/>ZC_BAPI_RUN"]
    Projection --> RootView["Root View<br/>ZR_BAPI_RUN"]
    RootView --> BDef["Behavior Definition<br/>ZR_BAPI_RUN (managed)"]
    BDef --> Handler["Behavior Pool<br/>zbp_r_bapi_run + lhc_bapi_run"]

    Handler --> Dispatcher["zcl_bapi_rap_dispatcher<br/>parse - defaults - split"]
    Handler -- "MODIFY ENTITY CREATE<br/>audit row + COMMIT ENTITIES" --> Table[("Table zbapi_run")]

    Dispatcher -- "202 Accepted<br/>{ RunUuid / BapiName / Accepted / Workers / ExecMode }" --> Client

    Dispatcher -- "CALL FUNCTION STARTING NEW TASK<br/>DESTINATION IN GROUP DEFAULT" --> W1["Z_BAPI_RAP_WORKER<br/>chunk 1"]
    Dispatcher --> W2["Z_BAPI_RAP_WORKER<br/>chunk 2"]
    Dispatcher --> Wn["Z_BAPI_RAP_WORKER<br/>chunk N"]

    W1 --> Caller1["zcl_bapi_rap_caller<br/>process_chunk"]
    W2 --> Caller2["zcl_bapi_rap_caller<br/>process_chunk"]
    Wn --> CallerN["zcl_bapi_rap_caller<br/>process_chunk"]

    subgraph PerDoc["Per document"]
        direction TB
        Introspect["FUNCTION_IMPORT_INTERFACE<br/>+ RTTI describe_by_name"]
        Map["Dynamic mapping<br/>ASSIGN COMPONENT"]
        Call["CALL FUNCTION bapi<br/>PARAMETER-TABLE / TABLES"]
        CommitDecision{"RETURN has<br/>E / A / X?"}
        Commit["BAPI_TRANSACTION_COMMIT"]
        Rollback["BAPI_TRANSACTION_ROLLBACK"]

        Introspect --> Map --> Call --> CommitDecision
        CommitDecision -- "no" --> Commit
        CommitDecision -- "yes" --> Rollback
    end

    Caller1 --> PerDoc
    Caller2 --> PerDoc
    CallerN --> PerDoc
