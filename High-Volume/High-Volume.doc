</tr>
</tbody>
</table>
</div>
<h3 local-id=3D"2179e136" id=3D"High-VolumeSAPSalesOrderLoadingArchitecture=
fromSKPUsingBAPIProcessing-Salesorderstructures">Sales order structures</h3=
>
<div class=3D"table-wrap">
