</tr>
</tbody>
</table>
</div>
<h3 local-id=3D"3cd80151" id=3D"High-VolumeSAPSalesOrderLoadingArchitecture=
fromSKPUsingBAPIProcessing-Messagetable">Message table</h3>
<div class=3D"table-wrap">
<table data-layout=3D"default" data-local-id=3D"651e6ac0" data-table-displa=
y-mode=3D"default" class=3D"confluenceTable">
<tbody>
<tr data-local-id=3D"25f4f530">
<th data-local-id=3D"1e2f91df" valign=3D"top" class=3D"confluenceTh">
<p local-id=3D"00673f8c">Column</p></th>
<th data-local-id=3D"270104f6" valign=3D"top" class=3D"confluenceTh">
<p local-id=3D"5b4b8c5e">Meaning</p></th>
</tr>
<tr data-local-id=3D"2d5287f5">
<td data-local-id=3D"6e36b175" valign=3D"top" class=3D"confluenceTd">
<p local-id=3D"79974649"><code>RUN_ID</code></p></td>
<td data-local-id=3D"4b06a1c0" valign=3D"top" class=3D"confluenceTd">
<p local-id=3D"72abc1c8">Migration run</p></td>
</tr>
<tr data-local-id=3D"1aae7fef">
